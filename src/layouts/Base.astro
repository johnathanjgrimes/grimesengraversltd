---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import config from '../data/config.json';
import { pageSchema, absUrl } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  faqs?: { q: string; a: string }[];
  scripts?: string[];
  fonts?: boolean;
  noindex?: boolean;
  image?: string;
  // The address Google should index when it isn't this page's own (other sizes of an award point to the main one).
  canonical?: string;
}
const { title, description, path, faqs = [], scripts = [], fonts = false, noindex = false, image = '/assets/img/glass-award.jpg', canonical: canonicalPath } = Astro.props;
const canonical = `${config.site}${canonicalPath ?? path}`;
// Set in .env locally and as GitHub Actions secrets for deploys. Analytics stays off when the key is missing.
const posthogKey = (import.meta.env.PUBLIC_POSTHOG_KEY ?? '').trim();
const posthogHost = (import.meta.env.PUBLIC_POSTHOG_HOST || 'https://eu.i.posthog.com').trim();
const schema = pageSchema(path, title, description, faqs, image);
---
<!doctype html>
<html lang="en-GB" data-stock-check={config.stockCheck} data-logo-uploads={config.logoUploads ? "on" : undefined}>
<head>
<meta charset="utf-8">
<script is:inline>
// Award photos are our own copies (/assets/awards/<SKU>-<size>.webp); if one is missing, show the supplier's.
document.addEventListener('error', function (e) {
  var img = e.target, m = img && img.tagName === 'IMG' && /\/assets\/awards\/(.+)-\d+\.webp$/.exec(img.getAttribute('src') || '');
  if (m && !img.dataset.fellBack) { img.dataset.fellBack = '1'; img.src = 'https://www.logocrystal.co.uk/images/products/promoserve/' + m[1] + '.jpg'; }
}, true);
</script>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex">}
<meta property="og:type" content="website">
<meta property="og:site_name" content={config.shortName}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={absUrl(image)}>
<meta property="og:locale" content="en_GB">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#23263A">
<meta name="geo.region" content="GB-CRF">
<meta name="geo.placename" content="Cardiff">
<link rel="icon" type="image/png" href="/assets/img/favicon.png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt">
<link rel="alternate" type="application/json" title="Award catalogue" href="/api/awards.json">
{!noindex && (!canonicalPath || canonicalPath === path) && <link rel="alternate" type="text/markdown" href={`${path}index.md`}>}
{fonts && <>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500&family=Cormorant+Garamond:ital,wght@1,500&family=Libre+Baskerville&family=Montserrat:wght@500&family=Pinyon+Script&family=UnifrakturMaguntia&display=swap" rel="stylesheet">
</>}
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
{posthogKey && <script is:inline define:vars={{ phKey: posthogKey, phHost: posthogHost }}>
!function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",function(){var l=function(){setTimeout(function(){(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r)},2000)};"complete"===t.readyState?l():window.addEventListener("load",l)}();var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once unregister identify setPersonProperties group reset get_distinct_id get_session_id alias set_config startSessionRecording stopSessionRecording opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
// No cookies or local storage (persistence: memory), so UK cookie rules don't require a consent banner.
posthog.init(phKey, { api_host: phHost, persistence: 'memory', person_profiles: 'identified_only', disable_session_recording: true });
</script>}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<Header path={path} />
<main id="main">
<slot />
</main>
<Footer />
<div id="quote-bar" class="quote-bar" hidden>
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3">
    <p class="m-0 quote-bar-text"><strong class="qb-label">Your quote:</strong> <span data-quote-bar-text></span></p>
    <div class="flex flex-wrap gap-2">
      <button type="button" data-open-quote class="btn qb-view" style="background: transparent; border: 2px solid #FFFFFF">View quote</button>
      <a href="/quote/" class="btn" style="background: #FFFFFF; color: #23263A">Continue →</a>
    </div>
  </div>
</div>
<div id="quote-panel" class="quote-panel" role="dialog" aria-modal="true" aria-labelledby="quote-panel-title" hidden>
  <div class="quote-panel-inner">
    <div class="flex items-center justify-between gap-4 border-0 border-b border-solid pb-3" style="border-color: #E5E7EB">
      <h2 id="quote-panel-title" class="m-0 text-xl font-semibold text-teal">Your quote</h2>
      <button type="button" data-panel-close class="opt" style="min-height: 2.5rem; padding: 0.3rem 0.8rem">Close ✕</button>
    </div>
    <ul data-panel-list class="m-0 flex-1 list-none overflow-y-auto p-0"></ul>
    <div class="border-0 border-t border-solid pt-3" style="border-color: #E5E7EB">
      <p class="m-0 mb-3 text-sm font-semibold" data-panel-total></p>
      <a href="/quote/" class="btn block text-center" data-panel-continue>Continue to quote details →</a>
      <a href="/glass-awards/" class="mt-2 block text-center text-sm font-semibold">Keep browsing awards</a>
      <p class="muted m-0 mt-3 text-center text-xs">Saved in this browser only. Prices are “from” prices; we confirm the full price, engraving included, by email.</p>
    </div>
  </div>
</div>
<script is:inline src="/js/basket.js" defer></script>
{scripts.map((s) => <script is:inline src={`/js/${s}`} defer></script>)}
<script is:inline src="/js/site.js" defer></script>
</body>
</html>
