---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import config from '../data/config.json';
import { pageSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  faqs?: { q: string; a: string }[];
  scripts?: string[];
  fonts?: boolean;
  noindex?: boolean;
  image?: string;
}
const { title, description, path, faqs = [], scripts = [], fonts = false, noindex = false, image = '/assets/img/glass-award.jpg' } = Astro.props;
const canonical = `${config.site}${path}`;
// Set in .env locally and as GitHub Actions secrets for deploys. Analytics stays off when the key is missing.
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY ?? '';
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://eu.i.posthog.com';
const schema = pageSchema(path, title, description, faqs, image);
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex">}
<meta property="og:type" content="website">
<meta property="og:site_name" content={config.shortName}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={`${config.site}${image}`}>
<meta property="og:locale" content="en_GB">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#23263A">
<meta name="geo.region" content="GB-CRF">
<meta name="geo.placename" content="Cardiff">
<link rel="icon" type="image/png" href="/assets/img/favicon.png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt">
{fonts && <>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500&family=Cormorant+Garamond:ital,wght@1,500&family=Libre+Baskerville&family=Montserrat:wght@500&family=Pinyon+Script&family=UnifrakturMaguntia&display=swap" rel="stylesheet">
</>}
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
{posthogKey && <script is:inline define:vars={{ phKey: posthogKey, phHost: posthogHost }}>
!function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once unregister identify setPersonProperties group reset get_distinct_id get_session_id alias set_config startSessionRecording stopSessionRecording opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
// No cookies or local storage (persistence: memory), so UK cookie rules don't require a consent banner.
posthog.init(phKey, { api_host: phHost, persistence: 'memory', person_profiles: 'identified_only', disable_session_recording: true });
</script>}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<Header path={path} />
<main id="main">
<slot />
</main>
<Footer />
{scripts.map((s) => <script is:inline src={`/js/${s}`} defer></script>)}
<script is:inline src="/js/site.js" defer></script>
</body>
</html>
