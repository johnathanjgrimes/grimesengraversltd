---
const { path } = Astro.props;
---
<div style="background: #23263A; color: #E5E7EB; font-size: 0.9rem">
<div style="max-width: 72rem; margin: 0 auto; padding: 0.5rem 1.5rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.25rem 1.5rem">
<span>Email only · Mon–Fri · Delivered UK-wide</span>
<span><a href="mailto:info@grimesengravers.com" style="color: #FFFFFF; text-decoration: none; font-weight: 600">info@grimesengravers.com</a> · Quotes within 24 hours</span>
</div></div>
<header style="background: #FFFFFF; border-bottom: 6px solid #23263A">
<div style="max-width: 72rem; margin: 0 auto; padding: 1rem 1.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem">
<a href="/" aria-label="Grimes Engravers home"><img src="/assets/img/logo.png" alt="Grimes Engravers – Professional Engravers since 1947" style="height: 3.25rem; width: auto; display: block"></a>
<button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav">☰ Menu</button>
<nav id="site-nav" aria-label="Main" style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1.1rem; font-size: 0.95rem"><a href="/corporate-glass-awards/" aria-current={path === "/corporate-glass-awards/" ? "page" : undefined} style={`color: ${path === "/corporate-glass-awards/" ? "#C8202A" : "#3D5A5E"}; font-weight: 600; text-decoration: none; padding: 0.6rem 0`}>Glass awards</a><a href="/memorial-bench-plaques/" aria-current={path === "/memorial-bench-plaques/" ? "page" : undefined} style={`color: ${path === "/memorial-bench-plaques/" ? "#C8202A" : "#3D5A5E"}; font-weight: 600; text-decoration: none; padding: 0.6rem 0`}>Bench plaques</a><a href="/bench-plaque-wording-ideas/" aria-current={path === "/bench-plaque-wording-ideas/" ? "page" : undefined} style={`color: ${path === "/bench-plaque-wording-ideas/" ? "#C8202A" : "#3D5A5E"}; font-weight: 600; text-decoration: none; padding: 0.6rem 0`}>Guides</a>
<a href="/contact/" style="background: #3D5A5E; color: #FFFFFF; font-weight: 700; text-decoration: none; padding: 0.65rem 1.1rem; border-radius: 6px">Get a quote</a></nav>
</div></header>
