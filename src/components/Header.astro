---
import collections from "../data/collections.json";
const { path } = Astro.props;
const ranges = collections.filter((c) => c.kind === "range");
const occasions = collections.filter((c) => c.kind === "occasion");
const slugs = collections.map((c) => `/${c.slug}/`);
const inAwards = path.startsWith("/glass-awards/") || path === "/quote/" || path === "/corporate-glass-awards/" || path === "/award-wording-ideas/" || slugs.includes(path);
const inPlaques = ["/memorial-bench-plaques/", "/bench-plaque-wording-ideas/", "/plaque-fonts/", "/can-i-put-a-plaque-on-a-bench/"].includes(path);
---
<div style="background: #23263A; color: #E5E7EB; font-size: 0.9rem">
<div class="topbar" style="max-width: 72rem; margin: 0 auto; padding: 0.4rem 1.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.25rem 1.5rem">
<span class="topbar-extra">Email only · Mon–Fri · Delivered UK-wide</span>
<span class="topbar-right"><span><a href="mailto:info@grimesengravers.com" style="color: #FFFFFF; text-decoration: none; font-weight: 600">info@grimesengravers.com</a><span class="hide-sm"> · Quotes within 24 hours</span></span>
<button type="button" id="quote-open" class="quote-open" hidden aria-haspopup="dialog" aria-controls="quote-panel">Your quote <span class="quote-count" data-quote-count>0</span></button></span>
</div></div>
<header style="background: #FFFFFF; border-bottom: 6px solid #23263A">
<div style="max-width: 72rem; margin: 0 auto; padding: 1rem 1.5rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem">
<a href="/" aria-label="Grimes Engravers home" class="header-logo"><img decoding="async" width="759" height="244" src="/assets/img/logo-grimes-engravers.svg" alt="Grimes Engravers" style="height: 3rem; width: auto; display: block"></a>
<a href="/glass-awards/" class="search-open" data-search-open aria-label="Search" aria-haspopup="dialog" aria-controls="site-search"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg><span class="search-label">Search</span></a>
<button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">☰<span class="hide-sm"> Menu</span></button>
<nav id="site-nav" aria-label="Main" class="site-nav">
<div class="nav-item">
  <a href="/glass-awards/" class:list={["nav-link", { active: inAwards }]} aria-current={path === "/glass-awards/" ? "page" : undefined}>Glass awards</a>
  <button type="button" class="nav-sub" aria-expanded="false" aria-controls="menu-awards" aria-label="Show glass award ranges and occasions"><span aria-hidden="true">▾</span></button>
  <div id="menu-awards" class="nav-menu nav-mega">
    <div>
      <p class="nav-head">By range</p>
      <a href="/glass-awards/">All glass awards</a>
      {ranges.map((c) => <a href={`/${c.slug}/`} aria-current={path === `/${c.slug}/` ? "page" : undefined}>{c.name}</a>)}
    </div>
    <div>
      <p class="nav-head">By occasion</p>
      {occasions.map((c) => <a href={`/${c.slug}/`} aria-current={path === `/${c.slug}/` ? "page" : undefined}>{c.name}</a>)}
      <a href="/corporate-glass-awards/">Glass awards for companies</a>
      <a href="/award-wording-ideas/" aria-current={path === "/award-wording-ideas/" ? "page" : undefined}>Wording &amp; category ideas</a>
    </div>
    <div class="nav-promo">
      <p class="nav-head">Not sure which one?</p>
      <p>Answer three quick questions and see awards that fit your occasion and budget.</p>
      <a href="/award-finder/" class="nav-btn">Try the award finder</a>
      <a href="/quote/">Or ask us to recommend</a>
    </div>
  </div>
</div>
<div class="nav-item">
  <a href="/memorial-bench-plaques/" class:list={["nav-link", { active: inPlaques }]} aria-current={path === "/memorial-bench-plaques/" ? "page" : undefined}>Bench plaques</a>
  <button type="button" class="nav-sub" aria-expanded="false" aria-controls="menu-plaques" aria-label="Show bench plaque pages and guides"><span aria-hidden="true">▾</span></button>
  <div id="menu-plaques" class="nav-menu">
    <a href="/memorial-bench-plaques/">Memorial bench plaques</a>
    <a href="/bench-plaque-wording-ideas/">Wording ideas</a>
    <a href="/plaque-fonts/">Font preview</a>
    <a href="/can-i-put-a-plaque-on-a-bench/">Can I put a plaque on a bench?</a>
  </div>
</div>
<div class="nav-item"><a href="/our-work/" class:list={["nav-link", { active: path === "/our-work/" }]}>Our work</a></div>
<div class="nav-item"><a href="/about/" class:list={["nav-link", { active: path === "/about/" }]}>About</a></div>
<a href="/contact/" class="nav-cta">Get a quote</a>
</nav>
</div></header>
