---
import config from "../data/config.json";
import { anniversary } from "../lib/anniversary";
---
<section aria-label="Some of our clients" style="background: #FFFFFF; padding: 2.5rem 1.5rem">
<div style="max-width: 72rem; margin: 0 auto; text-align: center"><p style="margin: 0 0 1rem; font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; color: #4B5563; font-weight: 700">Trusted by organisations across Wales and the UK</p>
<img loading="lazy" decoding="async" width="804" height="80" src="/assets/img/clients.webp" alt="Client logos" style="max-width: 100%; width: 46rem; height: auto"></div></section>
<footer style="background: #262833; color: #D1D5DB; padding: 3rem 1.5rem 2rem">
<div style="max-width: 72rem; margin: 0 auto; display: flex; flex-wrap: wrap; gap: 2.5rem">
<div style="flex: 1 1 16rem; min-width: 0">{anniversary ? <img src="/assets/img/heritage/grimes-engravers-80-years-cream.svg" width="759" height="284" alt="Grimes Engravers Ltd, 1947 to 2027, 80 years" loading="lazy" decoding="async" style="display: block; width: 11rem; height: auto; margin: 0 0 1rem"> : <img src="/assets/img/heritage/grimes-engravers-cream.svg" width="759" height="244" alt="Grimes Engravers Ltd" loading="lazy" decoding="async" style="display: block; width: 11rem; height: auto; margin: 0 0 1rem">}
<p style="margin: 0 0 0.75rem">Glass award engravers in Cardiff since 1947{anniversary && ", celebrating 80 years"}. No visits or collections: every order is delivered.</p>
<p style="margin: 0 0 0.25rem"><a href="mailto:info@grimesengravers.com" style="color: #FFFFFF">info@grimesengravers.com</a></p>
<p style="margin: 0 0 0.75rem">Enquiries by email only. Open Monday to Friday, with quotes within 24 hours.</p>
<p style="margin: 0">See our <a href={config.trustpilot} style="color: #FFFFFF; font-weight: 700">14 reviews on Trustpilot</a></p></div>
<div style="flex: 1 1 12rem; min-width: 0"><p style="margin: 0 0 0.6rem; color: #FFFFFF; font-weight: 700">What we supply</p><div style="display: flex; flex-direction: column; gap: 0.35rem"><a href="/glass-awards/" style="color: #D1D5DB; text-decoration: none">Choose a glass award</a><a href="/corporate-glass-awards/" style="color: #D1D5DB; text-decoration: none">Glass &amp; crystal awards</a><a href="/award-finder/" style="color: #D1D5DB; text-decoration: none">Award finder</a><a href="/quote/" style="color: #D1D5DB; text-decoration: none">Request a glass award quote</a><a href="/memorial-bench-plaques/" style="color: #D1D5DB; text-decoration: none">Memorial bench plaques</a></div></div>
<div style="flex: 1 1 12rem; min-width: 0"><p style="margin: 0 0 0.6rem; color: #FFFFFF; font-weight: 700">Awards by occasion</p><div style="display: flex; flex-direction: column; gap: 0.35rem"><a href="/long-service-awards/" style="color: #D1D5DB; text-decoration: none">Long service awards</a><a href="/retirement-awards/" style="color: #D1D5DB; text-decoration: none">Retirement awards</a><a href="/employee-of-the-year-awards/" style="color: #D1D5DB; text-decoration: none">Employee of the year awards</a><a href="/golf-awards/" style="color: #D1D5DB; text-decoration: none">Golf awards</a><a href="/football-awards/" style="color: #D1D5DB; text-decoration: none">Football awards</a><a href="/corporate-awards/" style="color: #D1D5DB; text-decoration: none">Corporate awards</a></div></div>
<div style="flex: 1 1 12rem; min-width: 0"><p style="margin: 0 0 0.6rem; color: #FFFFFF; font-weight: 700">Help &amp; guides</p><div style="display: flex; flex-direction: column; gap: 0.35rem"><a href="/about/" style="color: #D1D5DB; text-decoration: none">About us &amp; key facts</a><a href="/our-work/" style="color: #D1D5DB; text-decoration: none">Our work: photos</a><a href="/can-i-put-a-plaque-on-a-bench/" style="color: #D1D5DB; text-decoration: none">Can I put a plaque on a bench?</a><a href="/bench-plaque-wording-ideas/" style="color: #D1D5DB; text-decoration: none">Bench plaque wording ideas</a><a href="/plaque-fonts/" style="color: #D1D5DB; text-decoration: none">Plaque font preview</a><a href="/contact/" style="color: #D1D5DB; text-decoration: none">Get a quote</a></div></div>
</div>
<p style="max-width: 72rem; margin: 0 auto; margin-top: 2rem; font-size: 0.9rem; color: #C3C7CF">Areas: Cardiff, Penarth, Barry, Vale of Glamorgan, Newport, Caerphilly, Pontypridd, Bridgend and UK-wide by post.</p>
<p style="max-width: 72rem; margin: 0 auto; margin-top: 1rem; padding-top: 1.25rem; border-top: 1px solid #3F4250; font-size: 0.85rem; color: #9CA3AF">© {new Date().getFullYear()} Grimes Engravers Ltd, Cardiff. All rights reserved.</p>
</footer>
