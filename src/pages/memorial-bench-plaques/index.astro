---
import Base from "../../layouts/Base.astro";
import config from "../../data/config.json";
import faqs from "../../data/faqs.json";
const meta = {"url": "/memorial-bench-plaques/", "title": "Memorial Bench Plaques Cardiff | Grimes Engravers", "description": "Engraved brass and stainless steel memorial bench plaques. Welsh & English, free proof, screws included, UK delivery. Family engravers since 1947."};
---
<Base image="/assets/img/bench-plaque.jpg" title={meta.title} description={meta.description} path={meta.url} faqs={faqs["memorial-bench-plaques"]} scripts={[]}>
<section style="background: #F5F6F7; padding: 3.5rem 1.5rem">
<div style="max-width: 72rem; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; gap: 2.5rem">
<div style="flex: 1 1 26rem; min-width: 0">
<p style="margin: 0 0 0.75rem; color: #C8202A; font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase">Cardiff · South Wales · UK delivery</p>
<h1 style="margin: 0 0 1rem; color: #3D5A5E; font-weight: 600; font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.15">Memorial Bench Plaques</h1>
<p style="margin: 0 0 1.75rem; font-size: 1.15rem; color: #4B5563">Engraved brass and stainless steel plaques for park, garden, club and memorial benches. Made to last outdoors and engraved in our Cardiff workshop, in Welsh, English or both, with your logo in colour or black and white if you’d like one.</p>
<div style="display: flex; flex-wrap: wrap; gap: 0.75rem">
<a href="/contact/" style="background: #3D5A5E; color: #FFFFFF; font-weight: 700; text-decoration: none; padding: 0.85rem 1.4rem; border-radius: 6px">Request a quote</a>
<a href="mailto:info@grimesengravers.com" style="border: 2px solid #3D5A5E; color: #3D5A5E; font-weight: 700; text-decoration: none; padding: 0.75rem 1.3rem; border-radius: 6px">Email us</a>
</div></div><div style="flex: 1 1 22rem; min-width: 0"><img src="/assets/img/bench-plaque.jpg" alt="Brass memorial bench plaque reading Frank and Margaret Williams" style="width: 100%; height: 20rem; object-fit: cover; border-radius: 8px; display: block"></div></div></section><section style="background: #FFF8E6; padding: 1.25rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem">
<p style="margin: 0; color: #1F2933"><strong>Is the bench in a public park or cemetery?</strong> Most councils only allow plaques through their own scheme.</p>
<a href="/can-i-put-a-plaque-on-a-bench/" style="background: #23263A; color: #FFFFFF; font-weight: 700; text-decoration: none; padding: 0.7rem 1.2rem; border-radius: 6px">Take the 1-minute check</a></div></section><section style="background: #F5F6F7; padding: 4rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto"><h2 style="margin: 0 0 0.6rem; color: #3D5A5E; font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.1rem)">Materials &amp; logos</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: 1.5rem"><div style="background: #FFFFFF; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Brass</h3><p style="margin: 0; color: #4B5563">A warm, traditional look. Brass naturally darkens outdoors unless it’s lacquered or polished, which many people like as it ages.</p></div><div style="background: #FFFFFF; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Stainless steel</h3><p style="margin: 0; color: #4B5563">A modern silver finish that won’t rust or tarnish, and needs almost no care. Often chosen for exposed coastal spots.</p></div><div style="background: #FFFFFF; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Logos &amp; emblems</h3><p style="margin: 0; color: #4B5563">Add a logo, crest or emblem in full colour or black and white. Send us the file and we’ll include it on your proof.</p></div></div></section><section style="background: #FFFFFF; padding: 4rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto"><h2 style="margin: 0 0 0.6rem; color: #3D5A5E; font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.1rem)">How to order a bench plaque</h2>
<ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.5rem"><li style="display: flex; gap: 1rem"><span style="flex: none; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: #23263A; color: #FFFFFF; font-weight: 700; display: flex; align-items: center; justify-content: center">1</span><div><h3 style="margin: 0 0 0.25rem; font-size: 1.1rem; color: #1F2933">Check permission</h3><p style="margin: 0; color: #4B5563">If it’s not your bench, check the owner allows plaques. Our 1-minute check helps.</p></div></li><li style="display: flex; gap: 1rem"><span style="flex: none; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: #23263A; color: #FFFFFF; font-weight: 700; display: flex; align-items: center; justify-content: center">2</span><div><h3 style="margin: 0 0 0.25rem; font-size: 1.1rem; color: #1F2933">Choose wording &amp; size</h3><p style="margin: 0; color: #4B5563">Not sure what to say? See our <a href="/bench-plaque-wording-ideas/">wording ideas</a>, then <a href="/plaque-fonts/">preview your font</a>.</p></div></li><li style="display: flex; gap: 1rem"><span style="flex: none; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: #23263A; color: #FFFFFF; font-weight: 700; display: flex; align-items: center; justify-content: center">3</span><div><h3 style="margin: 0 0 0.25rem; font-size: 1.1rem; color: #1F2933">Approve your proof</h3><p style="margin: 0; color: #4B5563">We email a layout to check before we engrave.</p></div></li><li style="display: flex; gap: 1rem"><span style="flex: none; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: #23263A; color: #FFFFFF; font-weight: 700; display: flex; align-items: center; justify-content: center">4</span><div><h3 style="margin: 0 0 0.25rem; font-size: 1.1rem; color: #1F2933">Delivered to you</h3><p style="margin: 0; color: #4B5563">Usually ready 10–14 working days after you approve the proof, posted with fixings.</p></div></li></ol></div></section><section style="background: #FFFFFF; padding: 4rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto"><div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 1.5rem"><div style="background: #F5F6F7; border-radius: 8px; padding: 2rem"><h2 style="margin: 0 0 0.6rem; font-size: 1.5rem; font-weight: 600; color: #3D5A5E">Not just for memorials</h2><p style="margin: 0; color: #4B5563">Bench plaques also mark weddings, retirements, anniversaries and donations to clubs, schools and churches.</p></div></div></div></section><section style="background: #FFFFFF; padding: 4rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto"><div style="max-width: 48rem"><h2 style="margin: 0 0 0.6rem; color: #3D5A5E; font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.1rem)">Frequently asked questions</h2><details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0" open=""><summary style="font-weight: 700; cursor: pointer; color: #1F2933">Can I put my own plaque on a council bench?</summary><p style="margin: 0.6rem 0 0; color: #4B5563">Usually not. Most councils only allow plaques through their own dedication scheme, and unofficial plaques may be removed. Contact the council’s parks or bereavement team first.</p></details><details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0"><summary style="font-weight: 700; cursor: pointer; color: #1F2933">How many words fit on a bench plaque?</summary><p style="margin: 0.6rem 0 0; color: #4B5563">It depends on the size. As a guide, a 6 x 4 inch plaque fits 4–5 lines and an 8 x 3 inch plaque 3–4 lines. We’ll always send a proof so you can see the spacing.</p></details><details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0"><summary style="font-weight: 700; cursor: pointer; color: #1F2933">Can you engrave in Welsh?</summary><p style="margin: 0.6rem 0 0; color: #4B5563">Yes. We regularly engrave in Welsh, English or both.</p></details><details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0"><summary style="font-weight: 700; cursor: pointer; color: #1F2933">Can you add a logo?</summary><p style="margin: 0.6rem 0 0; color: #4B5563">Yes. We can add a logo, crest or emblem in full colour or black and white. Send it as a PDF, EPS, SVG or a clear image.</p></details><details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0"><summary style="font-weight: 700; cursor: pointer; color: #1F2933">Do the plaques come with screws?</summary><p style="margin: 0.6rem 0 0; color: #4B5563">Yes. Every bench plaque comes with stainless steel screws, so it won’t stain the wood.</p></details><details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0"><summary style="font-weight: 700; cursor: pointer; color: #1F2933">How long does a bench plaque take?</summary><p style="margin: 0.6rem 0 0; color: #4B5563">Typically 10–14 working days from approval of your proof.</p></details><details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0"><summary style="font-weight: 700; cursor: pointer; color: #1F2933">Can I collect my plaque?</summary><p style="margin: 0.6rem 0 0; color: #4B5563">No. We can’t offer collections. Every plaque is posted to you with its fixings.</p></details></div></div></section><section style="background: #F5F6F7; padding: 4rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto"><h2 style="margin: 0 0 0.6rem; color: #3D5A5E; font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.1rem)">Areas we cover</h2><p style="margin: 0 0 2rem; color: #4B5563; max-width: 44rem">Based in Cardiff, we deliver plaques anywhere in the UK.</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 2rem">
<div><h3 style="margin: 0 0 0.4rem; font-size: 1.1rem">Engravers in Cardiff</h3><p style="margin: 0; color: #4B5563">Canton, Llandaff, Whitchurch, Rhiwbina, Roath, Cyncoed, Llanishen, Radyr, Fairwater, Ely, Grangetown, Cardiff Bay</p></div>
<div><h3 style="margin: 0 0 0.4rem; font-size: 1.1rem">South Wales</h3><p style="margin: 0; color: #4B5563">Penarth, Barry, Dinas Powys, Cowbridge, Vale of Glamorgan, Newport, Caerphilly, Pontypridd, Llantrisant, Bridgend</p></div>
<div><h3 style="margin: 0 0 0.4rem; font-size: 1.1rem">UK-wide</h3><p style="margin: 0; color: #4B5563">Bench plaques posted securely anywhere in the UK.</p></div>
</div></div></section><section style="background: #3D5A5E; color: #FFFFFF; padding: 3.5rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem">
<div style="flex: 1 1 24rem"><h2 style="margin: 0 0 0.4rem; font-size: 1.8rem; font-weight: 600">Order a bench plaque</h2><p style="margin: 0; color: #E5ECEC">Send us your wording and size and we’ll email a proof.</p></div>
<div style="display: flex; flex-wrap: wrap; gap: 0.75rem"><a href="/contact/" style="background: #FFFFFF; color: #3D5A5E; font-weight: 700; text-decoration: none; padding: 0.85rem 1.4rem; border-radius: 6px">Request a quote</a>
<a href="mailto:info@grimesengravers.com" style="border: 2px solid #FFFFFF; color: #FFFFFF; font-weight: 700; text-decoration: none; padding: 0.75rem 1.3rem; border-radius: 6px">Email us</a></div></div></section>
</Base>
