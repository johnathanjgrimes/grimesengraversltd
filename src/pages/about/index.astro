---
import Base from '../../layouts/Base.astro';
import config from '../../data/config.json';
import faqs from '../../data/faqs.json';
import services from '../../data/services.json';
const meta = { url: '/about/', title: 'About Grimes Engravers | Celebrating 80 Years in Cardiff', description: 'Key facts about Grimes Engravers: family-run engravers in Cardiff since 1947, celebrating 80 years, what we supply and produce, who we work with, minimum orders and how to get a quote.' };
const facts = [
  ['Established', `${config.founded} in Cardiff, Wales. Family-run, now in its third generation and celebrating 80 years.`],
  ['What we supply & produce', 'Engraved glass and crystal awards, with a minimum order of 2 awards. Also memorial bench plaques in brass and stainless steel.'],
  ['Who we work with', 'Companies and organisations ordering glass awards, and families ordering a bench plaque.'],
  ['Minimum order', config.minimumOrder],
  ['Quotes & lead times', `Quotes ${config.quoteTime}. Orders take ${config.leadTime}. We work ${config.workingDays}.`],
  ['Visiting', 'No visits, appointments or collections. We work from a private workshop and deliver every order.'],
  ['Languages', 'We engrave in English, Welsh or both, including Welsh characters such as ŵ and ŷ.'],
  ['Areas', `${config.areas.join(', ')}, and anywhere in the UK by post.`],
  ['What we don’t do', 'Memorial, wall or opening plaques, nameplates, signs or labels, trophies or medals, personal items such as watches, jewellery and gifts, wooden items, while-you-wait engraving, or single glass awards.'],
  ['Contact', `By email only: ${config.email}`],
];
---
<Base title={meta.title} description={meta.description} path={meta.url} faqs={faqs['about']}>
<section class="bg-mist px-6 py-14">
  <div class="mx-auto max-w-4xl">
    <p class="m-0 mb-3 text-sm font-bold uppercase tracking-widest text-brand">About us</p>
    <p class="anniv-badge anniv-light">1947–2027 · {config.anniversary}</p>
    <h1 class="m-0 mb-4 text-4xl font-semibold leading-tight text-teal">Grimes Engravers: family engravers in Cardiff since 1947</h1>
    <p class="m-0 text-lg text-muted">{config.summary}</p>
  </div>
</section>
<section class="px-6 py-14">
  <div class="mx-auto max-w-4xl">
    <h2 class="m-0 mb-6 text-2xl font-semibold text-teal">Key facts</h2>
    <dl class="m-0 grid gap-x-8 gap-y-4 sm:grid-cols-[12rem_1fr]">
      {facts.map(([k, v]) => <>
        <dt class="font-bold text-ink">{k}</dt>
        <dd class="m-0 text-muted">{v}</dd>
      </>)}
    </dl>
  </div>
</section>
<section class="bg-mist px-6 py-14">
  <div class="mx-auto max-w-4xl">
    <h2 class="m-0 mb-6 text-2xl font-semibold text-teal">Our services</h2>
    <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2">
      {services.map((s) => <li class="rounded-lg bg-white p-5 shadow-sm">
        <a href={s.url} class="font-bold">{s.name}</a>
        <p class="m-0 mt-1 text-muted">{s.description}</p>
      </li>)}
    </ul>
  </div>
</section>
<section class="px-6 py-14">
  <div class="mx-auto max-w-4xl">
    <img src="/assets/img/heritage/grimes-engravers-80-years.svg" width="759" height="284" alt="Grimes Engravers, 1947 to 2027, 80 years" class="heritage-mark" loading="lazy" decoding="async">
    <h2 class="m-0 mb-4 text-2xl font-semibold text-teal">Our story: 80 years of engraving in Cardiff</h2>
    <div class="story-pair mb-6">
      <figure class="m-0" style="--r: 1.497"><img decoding="async" src="/assets/img/grimes-original-640.webp" srcset="/assets/img/grimes-original-640.webp 640w, /assets/img/grimes-original.webp 1024w" sizes="(max-width: 640px) 100vw, 36rem" alt="The original E J Grimes engravers shop front in Cardiff, in black and white" width="1024" height="684" loading="lazy" class="block h-auto w-full rounded-lg"><figcaption class="mt-2 text-sm text-muted">Our original shop in Cardiff.</figcaption></figure>
      <figure class="m-0" style="--r: 0.749"><img decoding="async" src="/assets/img/work/grimes-engravers-cardiff-shop-front-1998-640.webp" srcset="/assets/img/work/grimes-engravers-cardiff-shop-front-1998-640.webp 640w, /assets/img/work/grimes-engravers-cardiff-shop-front-1998-1200.webp 1200w" sizes="(max-width: 640px) 100vw, 18rem" alt="Grimes Engravers shop front in Cardiff in 1998, with engraving and trophies in the window" width="899" height="1200" loading="lazy" class="block h-auto w-full rounded-lg"><figcaption class="mt-2 text-sm text-muted">Our Cardiff shop front in 1998. We now work from a private workshop and deliver every order.</figcaption></figure>
    </div>
    <p class="text-muted">Grimes Engravers was founded in Cardiff in 1947, and 2027 marks our 80th anniversary. Three generations later we’re still a small family workshop, combining traditional hand skills with modern CAD/CAM engraving.</p>
    <p class="text-muted">Over the decades we’ve engraved for county councils, universities, hospitals, schools, hotels, national organisations and some of Cardiff’s largest employers, as well as for local families marking something that matters.</p>
    <p class="mt-6"><a class="btn" href="/contact/">Request a quote</a></p>
  </div>
</section>
</Base>
