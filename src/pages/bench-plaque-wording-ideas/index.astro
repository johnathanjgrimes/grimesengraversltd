---
import Base from "../../layouts/Base.astro";
import faqs from "../../data/faqs.json";
const meta = {"url": "/bench-plaque-wording-ideas/", "title": "Bench Plaque Wording: Mum, Dad & Pets | Grimes Engravers", "description": "Memorial bench plaque wording examples for mum, dad, husband or wife, parents, friends and pets, plus Welsh phrases and tips for clear plaques."};
// Each group is a heading people search for, with examples families have chosen. Names and dates are placeholders.
const groups = [
  { id: "classic", title: "Classic memorial wording", examples: ["In loving memory of\nMargaret Jones\n1938 – 2024", "In memory of\nJohn Davies\nwho loved this place", "Forever loved\nand never forgotten"] },
  { id: "mum", title: "Wording for mum", examples: ["In loving memory of\nour wonderful Mum\nMary Thomas\n1941 – 2025", "Mum\nYou gave us everything.\nForever in our hearts", "For Mum, who loved\nto sit here with her tea\nand watch the ducks", "In memory of Jean\nA much loved mum, nan\nand friend"] },
  { id: "dad", title: "Wording for dad", examples: ["In loving memory of\nDad\nAlan Hughes\n1939 – 2024", "Dad\nYour walk is over,\nrest here a while", "Remembering Dad\nwho never missed\na sunny afternoon here", "In memory of Ken\nDad, grandad and\nthe best of men"] },
  { id: "partner", title: "For a husband, wife or partner", examples: ["In loving memory of\nmy husband Peter\nForever my love", "For Sue, my wife\nand best friend\nfor 52 years", "Together again\nBill and Joan Morgan", "In memory of Gareth\nwho shared this view\nwith me every Sunday"] },
  { id: "parents", title: "For mum and dad, nan and grandad", examples: ["In loving memory of\nMum and Dad\nTogether forever", "Nos da Mam a Dad\n(Goodnight Mum and Dad)", "For Nan and Grandad\nwho loved this park\nand all of us", "Brian and Pat Lewis\nMarried 60 years\nMissed every day"] },
  { id: "child", title: "For a son, daughter or child", examples: ["In loving memory of\nour son Daniel\nForever 24", "For Ellie\nOur little star\nshining always", "Remembering James\nwho brought laughter\nto this place"] },
  { id: "friend", title: "For a friend or colleague", examples: ["In memory of\nSteve Powell\nA true friend", "For Linda, from all\nher friends at\n[Club name]", "Remembering a dear\ncolleague and friend\nRhian Edwards"] },
  { id: "pets", title: "For a dog or pet", examples: ["In memory of Bella\nwho loved every\nwalk in this park", "For Max\nOur faithful friend\n2011 – 2025", "Paws for a moment\nand remember Charlie"] },
  { id: "spot", title: "For someone who loved the spot", examples: ["Who loved this view", "Sit, rest and remember\nDavid Evans", "She loved to sit here\nand watch the world go by"] },
  { id: "welsh", title: "Welsh & bilingual", examples: ["Er cof annwyl am\n(In loving memory of)", "Am byth yn ein calonnau\n(Forever in our hearts)", "Hedd perffaith hedd\n(Perfect peace)", "Cariad am byth\n(Love forever)"] },
  { id: "short", title: "Short wording for small plaques", examples: ["Forever in our hearts", "Always loved, never forgotten", "Rest a while", "Gone but not forgotten"] },
  { id: "celebrations", title: "Celebrations & gifts", examples: ["Presented to mark\n50 years of marriage", "Donated by the members of\n[Club name], 2026", "Happy retirement\nEnjoy the view"] },
];
const card = "background: #FFFFFF; border: 1px solid #D9DEE2; border-radius: 6px; padding: 0.9rem 1rem; text-align: center; font-family: Georgia, 'Times New Roman', serif; white-space: pre-line";
---
<Base image="/assets/img/bench-plaque.jpg" title={meta.title} description={meta.description} path={meta.url} faqs={faqs["bench-plaque-wording-ideas"]} scripts={[]}>
<section style="background: #F5F6F7; padding: 3.5rem 1.5rem"><div style="max-width: 52rem; margin: 0 auto">
<p style="margin: 0 0 0.75rem; color: #C8202A; font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase">Guide</p>
<h1 style="margin: 0 0 1rem; color: #3D5A5E; font-weight: 600; font-size: clamp(2rem, 4.5vw, 2.8rem); line-height: 1.15">Memorial bench plaque wording ideas</h1>
<p style="margin: 0 0 1.25rem; font-size: 1.15rem; color: #4B5563">Finding the right words is often the hardest part. Here are examples families have chosen for a mum, dad, partner, friend or much-loved pet, plus tips on keeping the wording clear and readable.</p>
<nav aria-label="Wording ideas by person"><ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem">
  {groups.map((g) => <li><a href={`#${g.id}`} style="display: inline-block; background: #FFFFFF; border: 1px solid #D9DEE2; border-radius: 999px; padding: 0.35rem 0.8rem; font-size: 0.95rem; text-decoration: none; color: #3D5A5E; font-weight: 600">{g.title.replace(/^(Wording for|For) /, "").replace(/^./, (c) => c.toUpperCase())}</a></li>)}
</ul></nav>
</div></section>
<section style="background: #FFFFFF; padding: 4rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto"><div style="max-width: 52rem; margin: 0 auto">
{groups.map((g) => <div id={g.id} style="margin-bottom: 2.5rem; scroll-margin-top: 6rem"><h2 style="margin: 0 0 1rem; font-size: 1.3rem; color: #1F2933">{g.title}</h2><ul style={`list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(${g.examples.length === 4 ? "18rem" : "15rem"}, 1fr)); gap: 0.75rem`}>{g.examples.map((e) => <li style={card}>{e}</li>)}</ul></div>)}
<h2 style="margin: 0 0 0.6rem; color: #3D5A5E; font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.1rem)">Tips for good wording</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.5rem"><div style="background: #F5F6F7; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Keep it short</h3><p style="margin: 0; color: #4B5563">Fewer words mean larger, easier-to-read letters. As a guide, a 6 x 4 inch plaque fits 4–5 lines and an 8 x 3 inch plaque 3–4 lines.</p></div><div style="background: #F5F6F7; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Check the limits</h3><p style="margin: 0; color: #4B5563">Council schemes often limit the number of lines or characters, so check before you finalise. <a href="/can-i-put-a-plaque-on-a-bench/">Can I put a plaque on a bench?</a></p></div><div style="background: #F5F6F7; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Spell-check names &amp; dates</h3><p style="margin: 0; color: #4B5563">Ask a second family member to read it. We’ll send a proof, but you approve the text.</p></div><div style="background: #F5F6F7; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Welsh accents</h3><p style="margin: 0; color: #4B5563">We engrave Welsh characters such as ŵ and ŷ correctly, in Welsh, English or both.</p></div></div>
<p style="margin: 2rem 0 0; font-size: 1.1rem"><a href="/plaque-fonts/" style="font-weight: 700">Try your wording in our fonts →</a> &nbsp; <a href="/memorial-bench-plaques/" style="font-weight: 700">Brass and stainless steel plaques →</a></p>
</div></div></section>
<section style="background: #F5F6F7; padding: 4rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto"><div style="max-width: 48rem"><h2 style="margin: 0 0 0.6rem; color: #3D5A5E; font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.1rem)">Frequently asked questions</h2>
{faqs["bench-plaque-wording-ideas"].map((f, i) => <details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0" open={i === 0}><summary style="font-weight: 700; cursor: pointer; color: #1F2933">{f.q}</summary><p style="margin: 0.6rem 0 0; color: #4B5563">{f.a}</p></details>)}
</div></div></section>
<section style="background: #3D5A5E; color: #FFFFFF; padding: 3.5rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem">
<div style="flex: 1 1 24rem"><h2 style="margin: 0 0 0.4rem; font-size: 1.8rem; font-weight: 600">Happy with your wording?</h2><p style="margin: 0; color: #E5ECEC">Send it to us and we’ll email a proof showing exactly how it will look.</p></div>
<div style="display: flex; flex-wrap: wrap; gap: 0.75rem"><a href="/contact/" style="background: #FFFFFF; color: #3D5A5E; font-weight: 700; text-decoration: none; padding: 0.85rem 1.4rem; border-radius: 6px">Request a quote</a>
<a href="mailto:info@grimesengravers.com" style="border: 2px solid #FFFFFF; color: #FFFFFF; font-weight: 700; text-decoration: none; padding: 0.75rem 1.3rem; border-radius: 6px">Email us</a></div></div></section>
</Base>
