---
import Base from "../../layouts/Base.astro";
// Shown after an order or enquiry is sent (data-thanks="/thank-you/" in public/js/site.js).
// Kept out of Google (noindex) and the sitemap. Visits to this page = enquiries sent, which makes
// it the conversion page for PostHog and, if ads are ever run, Google Ads.
const meta = { url: "/thank-you/", title: "Thank You: Your Order Is On Its Way | Grimes Engravers", description: "Thank you for your order. We'll email your price and a free proof within 24 hours (working days). Nothing to pay today." };
const step = "display: flex; gap: 1rem; align-items: flex-start";
const num = "flex: none; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: #3D5A5E; color: #FFFFFF; font-weight: 700; display: flex; align-items: center; justify-content: center";
---
<Base title={meta.title} description={meta.description} path={meta.url} noindex={true} scripts={[]}>
<section style="background: #F5F6F7; padding: 3.5rem 1.5rem"><div style="max-width: 44rem; margin: 0 auto">
<p style="margin: 0 0 0.75rem; color: #C8202A; font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase">Order sent</p>
<h1 style="margin: 0 0 1rem; color: #3D5A5E; font-weight: 600; font-size: clamp(2rem, 4.5vw, 2.8rem); line-height: 1.15">Thank you, it’s on its way</h1>
<p style="margin: 0; font-size: 1.15rem; color: #4B5563">We’ve received your order and will email you from <strong>info@grimesengravers.com</strong>, usually within a few hours on working days and always within 24 hours. There’s nothing to pay today.</p>
</div></section>

<section style="background: #FFFFFF; padding: 3.5rem 1.5rem"><div style="max-width: 44rem; margin: 0 auto">
<h2 style="margin: 0 0 1.25rem; color: #3D5A5E; font-weight: 600; font-size: 1.6rem">What happens next</h2>
<ol style="list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem">
<li style={step}><span style={num}>1</span><div><p style="margin: 0; font-weight: 700; color: #1F2933">We check your order and email your price</p><p style="margin: 0; color: #4B5563">The full price, including engraving and delivery. Adding a logo? Just reply with the file.</p></div></li>
<li style={step}><span style={num}>2</span><div><p style="margin: 0; font-weight: 700; color: #1F2933">You approve a free proof</p><p style="margin: 0; color: #4B5563">We show exactly how the engraving will look before anything is engraved.</p></div></li>
<li style={step}><span style={num}>3</span><div><p style="margin: 0; font-weight: 700; color: #1F2933">We engrave and check by hand</p><p style="margin: 0; color: #4B5563">Usually ready 10–14 working days after you approve the proof.</p></div></li>
<li style={step}><span style={num}>4</span><div><p style="margin: 0; font-weight: 700; color: #1F2933">Pay when you’re happy, and it’s delivered</p><p style="margin: 0; color: #4B5563">We send your invoice by email: pay by card or bank transfer. Delivered anywhere in the UK. <a href="/why-we-proof-first/">Why we work this way</a>.</p></div></li>
</ol>
<p style="margin: 2rem 0 0; background: #FFF8E6; border-radius: 6px; padding: 1rem; color: #1F2933">Not heard from us? Check your spam or junk folder, or email <a href="mailto:info@grimesengravers.com">info@grimesengravers.com</a>.</p>
<p style="margin: 2rem 0 0; font-size: 1.05rem"><a href="/our-work/" style="font-weight: 700">See work we’ve engraved →</a> &nbsp; <a href="/award-wording-ideas/" style="font-weight: 700">Award wording ideas →</a> &nbsp; <a href="/bench-plaque-wording-ideas/" style="font-weight: 700">Plaque wording ideas →</a></p>
</div></section>
</Base>
