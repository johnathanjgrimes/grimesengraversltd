---
import Base from "../layouts/Base.astro";
import config from "../data/config.json";
import faqs from "../data/faqs.json";
const meta = {"url": "/", "title": "Glass & Crystal Awards Cardiff | Grimes Engravers", "description": "Engraved glass and crystal awards for staff awards, long service and events. Minimum order 2. Family engravers in Cardiff since 1947. Quotes in 24 hours."};
---
<Base title={meta.title} description={meta.description} path={meta.url} faqs={faqs["index"]} scripts={[]}>
<section style="background: #23263A; color: #FFFFFF; padding: 4rem 1.5rem">
<div style="max-width: 72rem; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; gap: 3rem">
<div style="flex: 1 1 26rem; min-width: 0">
<p style="display: inline-block; margin: 0 0 1rem; background: #FFFFFF; color: #23263A; font-weight: 700; font-size: 0.95rem; padding: 0.35rem 0.8rem; border-radius: 999px">Minimum order 2 awards</p>
<p style="margin: 0 0 0.75rem; color: #F3A3A6; font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase">Engravers in Cardiff since 1947</p>
<h1 style="margin: 0 0 1rem; font-weight: 600; font-size: clamp(2.1rem, 5vw, 3.3rem); line-height: 1.12">Engraved glass &amp; crystal awards</h1>
<p style="margin: 0 0 1.75rem; font-size: 1.15rem; color: #D1D5DB">Glass and crystal awards for staff awards nights, long service and events, engraved with your logo and wording by three generations of the Grimes family. Minimum order 2 awards.</p>
<div style="display: flex; flex-wrap: wrap; gap: 0.75rem">
<a href="/glass-awards/" style="background: #FFFFFF; color: #23263A; font-weight: 700; text-decoration: none; padding: 0.85rem 1.4rem; border-radius: 6px">Choose your award</a>
<a href="/contact/" style="border: 2px solid #9CA3AF; color: #FFFFFF; font-weight: 700; text-decoration: none; padding: 0.75rem 1.3rem; border-radius: 6px">Request a quote</a></div>
<ul style="list-style: none; margin: 1.75rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; color: #D1D5DB; font-size: 0.95rem"><li>✓ Minimum 2 awards</li><li>✓ Quotes within 24 hours</li><li>✓ Proof before we engrave</li><li>✓ Ready 10–14 working days after proof</li></ul></div>
<div style="flex: 1 1 22rem; min-width: 0"><img src="/assets/img/glass-award.jpg" alt="Engraved glass award" style="width: 100%; height: 21rem; object-fit: cover; border-radius: 8px; display: block"></div>
</div></section>
<section aria-label="Minimum order" style="background: #FFF8E6; border-bottom: 1px solid #F1E2B8; padding: 1.25rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem">
<p style="margin: 0; color: #1F2933; font-size: 1.15rem"><strong>Minimum order: 2 glass awards in total.</strong> Mix and match different awards and sizes.</p>
<a href="/contact/" style="background: #23263A; color: #FFFFFF; font-weight: 700; text-decoration: none; padding: 0.7rem 1.2rem; border-radius: 6px">Get a quote</a></div></section>
<section style="background: #FFFFFF; padding: 4rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto"><h2 style="margin: 0 0 0.6rem; color: #3D5A5E; font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.1rem)">Glass awards for every occasion</h2><p style="margin: 0 0 2rem; color: #4B5563; max-width: 44rem">Repeat work for some of Cardiff’s largest employers, year after year.</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.5rem"><div style="background: #F5F6F7; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Staff awards nights</h3><p style="margin: 0; color: #4B5563">Recognition pieces engraved with your logo and each winner’s name.</p></div><div style="background: #F5F6F7; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Long service</h3><p style="margin: 0; color: #4B5563">Glass awards for 10, 20 and 25 years’ service.</p></div><div style="background: #F5F6F7; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Sales &amp; performance</h3><p style="margin: 0; color: #4B5563">Awards for top performers, teams and milestones.</p></div><div style="background: #F5F6F7; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Events &amp; sponsors</h3><p style="margin: 0; color: #4B5563">Glass pieces for sponsored events, charity days and VIPs.</p></div></div>
<p style="margin: 2rem 0 0"><a href="/glass-awards/" style="font-weight: 700">Browse all glass &amp; crystal awards →</a></p></div></section>
<section style="background: #F5F6F7; padding: 4rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto"><div style="display: flex; flex-wrap: wrap; gap: 3rem">
<div style="flex: 1 1 22rem; min-width: 0"><h2 style="margin: 0 0 0.6rem; color: #3D5A5E; font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.1rem)">Catalogue &amp; pricing</h2><p style="margin: 0 0 1rem; color: #4B5563">Browse our glass and crystal catalogue and note the product codes you like. The prices shown are per award. Engraving is added on top, and we confirm the full price in your quote.</p><p style="margin: 0"><a href="/glass-awards/" style="display: inline-block; background: #3D5A5E; color: #FFFFFF; font-weight: 700; text-decoration: none; padding: 0.8rem 1.3rem; border-radius: 6px">Browse glass awards</a></p></div>
<div style="flex: 1 1 22rem; min-width: 0"><ol style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.25rem"><li style="display: flex; gap: 1rem"><span style="flex: none; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: #23263A; color: #FFFFFF; font-weight: 700; display: flex; align-items: center; justify-content: center">1</span><div><h3 style="margin: 0 0 0.25rem; font-size: 1.1rem; color: #1F2933">Email your codes</h3><p style="margin: 0; color: #4B5563">Catalogue codes, quantity (2 or more), wording, logo and date.</p></div></li><li style="display: flex; gap: 1rem"><span style="flex: none; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: #23263A; color: #FFFFFF; font-weight: 700; display: flex; align-items: center; justify-content: center">2</span><div><h3 style="margin: 0 0 0.25rem; font-size: 1.1rem; color: #1F2933">Quote within 24 hours</h3><p style="margin: 0; color: #4B5563">One price for the whole order, on working days (Monday to Friday).</p></div></li><li style="display: flex; gap: 1rem"><span style="flex: none; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: #23263A; color: #FFFFFF; font-weight: 700; display: flex; align-items: center; justify-content: center">3</span><div><h3 style="margin: 0 0 0.25rem; font-size: 1.1rem; color: #1F2933">Approve your proof</h3><p style="margin: 0; color: #4B5563">We email a proof of the engraving for you to sign off.</p></div></li><li style="display: flex; gap: 1rem"><span style="flex: none; width: 2.6rem; height: 2.6rem; border-radius: 50%; background: #23263A; color: #FFFFFF; font-weight: 700; display: flex; align-items: center; justify-content: center">4</span><div><h3 style="margin: 0 0 0.25rem; font-size: 1.1rem; color: #1F2933">Ready in 10–14 working days</h3><p style="margin: 0; color: #4B5563">From your approval of the proof, then delivered to you.</p></div></li></ol></div>
</div></div></section>
<section style="background: #FFFFFF; padding: 3rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem">
<p style="margin: 0; color: #4B5563; font-size: 1.1rem"><strong style="color: #1F2933">Also available:</strong> memorial bench plaques in brass and stainless steel, with no minimum order.</p>
<a href="/memorial-bench-plaques/" style="font-weight: 700">See bench plaques →</a></div></section>
<section style="background: #F5F6F7; padding: 4rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto"><div style="display: flex; flex-wrap: wrap; gap: 3rem">
<div style="flex: 1 1 24rem; min-width: 0"><h2 style="margin: 0 0 0.6rem; color: #3D5A5E; font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.1rem)">How we work</h2><p style="margin: 0 0 1rem; color: #4B5563">Grimes Engravers was established in Cardiff in 1947, and three generations later we’re still a small family workshop. You deal directly with the people doing the engraving.</p><figure style="margin: 1.5rem 0 0"><img src="/assets/img/grimes-original.jpg" alt="The original E J Grimes engravers shop front in Cardiff, in black and white" width="1024" height="684" loading="lazy" style="display: block; width: 100%; height: auto; border-radius: 8px"><figcaption style="margin-top: 0.5rem; font-size: 0.9rem; color: #4B5563">Our original shop in Cardiff.</figcaption></figure><p style="margin: 0 0 1rem; color: #4B5563">We work Monday to Friday from a private workshop, so we can’t take visits or collections. Everything is arranged by email: we send a quote within 24 hours, then a proof, and your order is ready 10–14 working days after you approve it.</p></div>
<div style="flex: 1 1 20rem; min-width: 0"><div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1.5rem"><div style="background: #FFFFFF; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Proof first</h3><p style="margin: 0; color: #4B5563">You approve the layout before we engrave.</p></div><div style="background: #FFFFFF; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Your logo</h3><p style="margin: 0; color: #4B5563">Send it as a PDF, EPS or SVG and we set it up for engraving.</p></div><div style="background: #FFFFFF; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Repeat orders</h3><p style="margin: 0; color: #4B5563">Your artwork and spec kept on file, so next year matches.</p></div><div style="background: #FFFFFF; border-radius: 8px; padding: 1.5rem"><h3 style="margin: 0 0 0.4rem; font-size: 1.15rem; color: #1F2933">Welsh &amp; English</h3><p style="margin: 0; color: #4B5563">Engraving in Welsh, English or both.</p></div></div></div></div></div></section>
<section style="background: #FFFFFF; padding: 4rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto"><h2 style="margin: 0 0 0.6rem; color: #3D5A5E; font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.1rem)">Areas we cover</h2><p style="margin: 0 0 2rem; color: #4B5563; max-width: 44rem">Based in Cardiff, we deliver orders anywhere in the UK.</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 2rem">
<div><h3 style="margin: 0 0 0.4rem; font-size: 1.1rem">Engravers in Cardiff</h3><p style="margin: 0; color: #4B5563">Canton, Llandaff, Whitchurch, Rhiwbina, Roath, Cyncoed, Llanishen, Radyr, Fairwater, Ely, Grangetown, Cardiff Bay</p></div>
<div><h3 style="margin: 0 0 0.4rem; font-size: 1.1rem">South Wales</h3><p style="margin: 0; color: #4B5563">Penarth, Barry, Dinas Powys, Cowbridge, Vale of Glamorgan, Newport, Caerphilly, Pontypridd, Llantrisant, Bridgend</p></div>
<div><h3 style="margin: 0 0 0.4rem; font-size: 1.1rem">UK-wide</h3><p style="margin: 0; color: #4B5563">Glass awards and bench plaques posted securely anywhere in the UK.</p></div>
</div></div></section>
<section style="background: #F5F6F7; padding: 4rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto"><div style="max-width: 48rem"><h2 style="margin: 0 0 0.6rem; color: #3D5A5E; font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.1rem)">Frequently asked questions</h2><details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0" open=""><summary style="font-weight: 700; cursor: pointer; color: #1F2933">Is there a minimum order for glass awards?</summary><p style="margin: 0.6rem 0 0; color: #4B5563">Yes. Glass award orders start at 2 awards in total, and you can mix different awards and sizes.</p></details><details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0"><summary style="font-weight: 700; cursor: pointer; color: #1F2933">Do catalogue prices include engraving?</summary><p style="margin: 0.6rem 0 0; color: #4B5563">No. Catalogue prices are per award, and engraving is added on top. We confirm the full price in your quote.</p></details><details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0"><summary style="font-weight: 700; cursor: pointer; color: #1F2933">How long does an order take?</summary><p style="margin: 0.6rem 0 0; color: #4B5563">We quote within 24 hours on working days (Monday to Friday). Orders are ready 10–14 working days after you approve our proof.</p></details><details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0"><summary style="font-weight: 700; cursor: pointer; color: #1F2933">Do you supply trophies or medals?</summary><p style="margin: 0.6rem 0 0; color: #4B5563">No. For awards we only supply glass and crystal.</p></details><details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0"><summary style="font-weight: 700; cursor: pointer; color: #1F2933">Can you engrave my watch or a single gift?</summary><p style="margin: 0.6rem 0 0; color: #4B5563">No. We don’t engrave personal items or gifts.</p></details><details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0"><summary style="font-weight: 700; cursor: pointer; color: #1F2933">Do you have a shop I can visit?</summary><p style="margin: 0.6rem 0 0; color: #4B5563">No. We work from a private workshop and can’t take visits or collections. Everything is arranged by email, and every order is delivered to you.</p></details><details style="border-bottom: 1px solid #E5E7EB; padding: 1rem 0"><summary style="font-weight: 700; cursor: pointer; color: #1F2933">Do you still make bench plaques?</summary><p style="margin: 0.6rem 0 0; color: #4B5563">Yes. We engrave external plaques in brass and stainless steel, <a href="/memorial-bench-plaques/">memorial bench plaques</a> in brass and stainless steel. Bench plaques have no minimum order.</p></details></div></div></section>
<section style="background: #3D5A5E; color: #FFFFFF; padding: 3.5rem 1.5rem"><div style="max-width: 72rem; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem">
<div style="flex: 1 1 24rem"><h2 style="margin: 0 0 0.4rem; font-size: 1.8rem; font-weight: 600">Planning an awards night?</h2><p style="margin: 0; color: #E5ECEC">Email your catalogue codes, quantity and date and we’ll quote within 24 hours (working days).</p></div>
<div style="display: flex; flex-wrap: wrap; gap: 0.75rem"><a href="/contact/" style="background: #FFFFFF; color: #3D5A5E; font-weight: 700; text-decoration: none; padding: 0.85rem 1.4rem; border-radius: 6px">Request a quote</a>
<a href="mailto:info@grimesengravers.com" style="border: 2px solid #FFFFFF; color: #FFFFFF; font-weight: 700; text-decoration: none; padding: 0.75rem 1.3rem; border-radius: 6px">Email us</a></div></div></section>
</Base>
